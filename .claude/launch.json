{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8060",
        "--bind",
        "127.0.0.1",
        "--directory",
        "build/web"
      ],
      "port": 8060
    },
    {
      "name": "hostinger-local",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8090",
        "-t",
        "build/hostinger"
      ],
      "port": 8090
    }
  ]
}